{
  "name": "nayr",
  "description": "Fast, lock-free Node.js package manager - drop-in replacement for Yarn Classic v1. Written in Zig.",
  "version": "2.0.0",
  "license": "MIT",
  "repository": "https://github.com/callmeteus/nayr",
  "author": "Gio <gio@techtail.net>",
  "bin": {
    "nayr": "./bin/nayr"
  },
  "files": [
    "bin",
    "zig-out/bin"
  ],
  "scripts": {
    "build": "zig build -Doptimize=ReleaseFast",
    "build:debug": "zig build",
    "link:dev": "sh bin/link-dev",
    "link:dev:release": "sh bin/link-dev --release",
    "test": "sh tests/run.sh all --no-yarn",
    "test:unit": "sh tests/run.sh unit",
    "test:integration": "sh tests/run.sh integration --no-yarn",
    "test:compare": "sh tests/run.sh integration",
    "bench": "sh tests/run.sh bench --no-yarn",
    "bench:compare": "sh tests/run.sh bench",
    "ci": "sh tests/run.sh ci"
  }
}
