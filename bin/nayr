#!/bin/sh
# nayr - wrapper script for the compiled Zig binary.
#
# When installed via npm/yarn (global or local), this script is the entry
# point. It resolves the pre-built binary relative to its own location and
# exec's into it, passing all arguments through.
#
# If the binary is missing (e.g. the package was installed from source without
# a pre-build step), it attempts a release build using Zig.

set -e

# Resolve the true directory of this script, following symlinks.
SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
NAYR_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

NAYR_BIN="$NAYR_ROOT/zig-out/bin/nayr"

# If the binary doesn't exist, try to build it.
if [ ! -f "$NAYR_BIN" ]; then
    echo "nayr: pre-built binary not found at $NAYR_BIN" >&2
    echo "nayr: attempting release build (requires Zig in PATH)..." >&2

    # Prefer ~/.local/bin/zig (pinned version) over any IDE-injected Zig.
    ZIG_BIN=""
    for candidate in "$HOME/.local/bin/zig" "$HOME/.local/zig/zig" "$(command -v zig 2>/dev/null)"; do
        if [ -f "$candidate" ] && [ -x "$candidate" ]; then
            ZIG_BIN="$candidate"
            break
        fi
    done

    if [ -z "$ZIG_BIN" ]; then
        echo "nayr: error: Zig not found. Install Zig or provide a pre-built binary." >&2
        exit 1
    fi

    (cd "$NAYR_ROOT" && "$ZIG_BIN" build -Doptimize=ReleaseFast) || {
        echo "nayr: build failed." >&2
        exit 1
    }
fi

exec "$NAYR_BIN" "$@"
